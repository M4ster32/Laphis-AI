# =============================================
# LAPHIS — Variáveis de Ambiente
# =============================================
# Copia este ficheiro para .env e preenche os valores.
# O backend carrega automaticamente via python-dotenv.

# ---- Base de Dados ----
# SQLite (default, desenvolvimento local — não precisa de configurar)
# DATABASE_URL=sqlite:///ai-service/src/data/laphis.db

# PostgreSQL (produção — ex: Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/laphis

# ---- OpenAI (IA) ----
# Se configurado, o chat, planos e adaptação usam IA real (GPT).
# Se não, o sistema funciona com regras/templates (sem custo).
OPENAI_API_KEY=
LAPHIS_CHAT_MODEL=gpt-4o-mini

# ---- Segurança ----
SECRET_KEY=laphis-secret-key-change-in-production

# ---- Email (verificação + reset password) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Ambiente ----
ENVIRONMENT=development
